rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /audioProgress/{doc} {
        allow read, write: if isOwner(uid);
      }
      match /freeProgress/{doc} {
        allow read, write: if isOwner(uid);
      }
      match /progress/{doc} {
        allow read, write: if isOwner(uid);
      }
      match /reflections/{doc} {
        allow read, write: if isOwner(uid);
      }
      match /gamification/{doc} {
        allow read, write: if isOwner(uid);
      }
      match /dailyGoal/{doc} {
        allow read, write: if isOwner(uid);
      }
      match /unlockedCantos/{doc} {
        allow read, write: if isOwner(uid);
      }
      match /bookmark/{doc} {
        allow read, write: if isOwner(uid);
      }
      match /talleres/{doc} {
        allow read, write: if isOwner(uid);
      }
      match /profile/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

  }
}
