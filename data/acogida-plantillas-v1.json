{
  "version": "acogida-v1",
  "_contrato": "Toda interacción emite { tipo, valor, eco }. La mecánica define la FORMA de captura; la señal es uniforme y alimenta tanto el eco como la afinidad del usuario en Firestore.",
  "_uso_sidecar": "El sidecar de cada Misterio nombra 2-3 tipos en su campo 'acogida'. Un string usa la mecánica por defecto: \"presencia\". Un objeto pide una alterna: { \"tipo\": \"intensidad\", \"mecanica\": \"sendero\" } o { \"tipo\": \"necesidad\", \"mecanica\": \"mosaico\", \"modo\": \"ambiente\" }.",
  "_composicion": "Regla de arco: cada Misterio elige tipos en orden de familia, de 'recibir el estado' hacia 'orientar a la oración', prefiriendo al menos un tipo no-mosaico para que la acogida no se sienta repetitiva.",
  "familias": {
    "comoEstas": "Cómo estás",
    "tuSituacion": "Tu situación",
    "comoLoNombras": "Cómo lo nombras",
    "dondeConDios": "Dónde estás con Dios",
    "queBuscas": "Qué buscas"
  },
  "mecanicas": {
    "termometro": {
      "emite": "tramo",
      "orientacion": "vertical",
      "_nota": "orientacion configurable: vertical u horizontal"
    },
    "rodillo": {
      "emite": "clave",
      "_nota": "carrete de rostros/emojis; usa el mismo set de opciones que 'corazones'"
    },
    "corazones": {
      "emite": "clave",
      "_nota": "elegir un corazón y colocarlo en el hueco; los rostros, si se usan, serenos y compuestos, nunca caricaturescos"
    },
    "cuerpo": {
      "emite": "zona",
      "seleccionMultiple": true
    },
    "mosaico": {
      "emite": "clave",
      "modos": [
        "ilustracion",
        "palabra",
        "ambiente"
      ],
      "modoDefault": "ilustracion",
      "_nota": "mismas opciones, distinto render. 'ambiente' es generativo (paleta+movimiento+son+haptica), multisensorial y de cuatro canales. 'sonido' nunca es el único camino: el texto siempre visible."
    },
    "cercania": {
      "emite": "clave",
      "_nota": "colocar 'yo' respecto a Lux. Lux no se acerca ni se aleja: ninguna posición es mejor. Permite la desolación sin corregirla."
    },
    "sendero": {
      "emite": "paso"
    },
    "brujula": {
      "emite": "clave",
      "estado": "v2",
      "_nota": "direccional, para 'mocion'; por ahora 'mocion' entra como mosaico"
    },
    "peso": {
      "emite": "clave",
      "_nota": "figura humana que carga un bulto de tamaño creciente (nada/poco/bastante/mucho); assets webp ad hoc en acogida/peso/{clave}.webp. Mide la CARGA (tamaño), distinta del impacto (termómetro 'intensidad')."
    }
  },
  "haptica": {
    "_nota": "Hook previsto para Capacitor (@capacitor/haptics, iOS+Android). Web: navigator.vibrate (solo Android; iOS web no soporta). Toggleable en ajustes.",
    "suave": {
      "capacitor": "impactLight",
      "web": [
        15
      ],
      "sentido": "un pulso largo y suave"
    },
    "doble": {
      "capacitor": "impactMedium(x2)",
      "web": [
        12,
        60,
        12
      ],
      "sentido": "dos toques"
    },
    "hondo": {
      "capacitor": "impactHeavy",
      "web": [
        40
      ],
      "sentido": "un pulso hondo"
    }
  },
  "assets": {
    "ilustrado": "acogida/{mecanica}/{clave}.webp",
    "ambiente": "generativo, sin asset (paleta + movimiento + son sintetizado + haptica)",
    "son_generativo": "por código (WebAudio); presets: pad, campana, gota, respiracion"
  },
